# Defaults require no model account. This file is a template; export variables explicitly.
DATABASE_URL=sqlite+aiosqlite:///runtime.db
MODEL_PROVIDER=mock
MODEL_NAME=deterministic-v1
MODEL_BASE_URL=https://api.openai.com/v1/
MODEL_API_KEY=
RUNTIME_LOG_LEVEL=WARNING
# Docker Compose PostgreSQL development password; change for any deployment.
POSTGRES_PASSWORD=runtime-local-only
